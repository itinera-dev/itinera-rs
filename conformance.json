{
  "cases": "v0.1.0-rc.7",
  "proposals": [2, 8, 9, 10, 11, 12, 24, 27, 32, 40, 41, 42, 49, 54, 55, 56, 57, 58, 60, 61, 62, 63, 64, 65, 81, 83, 85],
  "capabilities": ["sync", "async"],
  "impossible": {
    "invalid-lifecycle": [
      {
        "feature": "cases/tier-1/0010-hooks-lifecycles-and-roles/order-and-lifecycles.feature",
        "scenario": "A lifecycle a hook may not return aborts the journey",
        "proof": { "test": "a_failure_hook_cannot_finish_the_workflow", "file": "crates/itinera/tests/proofs.rs" }
      }
    ],
    "role-not-provided": [
      {
        "feature": "cases/tier-1/0010-hooks-lifecycles-and-roles/roles.feature",
        "scenario": "A policy needing a role the workflow does not provide is refused at admission",
        "proof": { "test": "a_policy_cannot_be_attached_to_a_workflow_that_does_not_provide_its_role", "file": "crates/itinera/tests/proofs.rs" }
      }
    ],
    "non-value": [
      {
        "feature": "cases/tier-1/0056-data-bag-values/data-bag-values.feature",
        "scenario": "A step that contributes a non-value aborts the journey",
        "proof": { "test": "a_step_cannot_contribute_a_non_value", "file": "crates/itinera/tests/proofs.rs" }
      },
      {
        "feature": "cases/tier-1/0056-data-bag-values/data-bag-values.feature",
        "scenario": "Initial data holding a non-value is refused before any journey",
        "proof": { "test": "initial_data_cannot_hold_a_non_value", "file": "crates/itinera/tests/proofs.rs" }
      },
      {
        "feature": "cases/tier-1/0056-data-bag-values/data-bag-values.feature",
        "scenario": "An input adapter that supplies a non-value aborts with \"step could not be built\"",
        "proof": { "test": "an_input_adapter_cannot_supply_a_non_value", "file": "crates/itinera/tests/proofs.rs" }
      },
      {
        "feature": "cases/tier-1/0064-event-data-values/reason-details.feature",
        "scenario": "A failure whose details are not a value aborts the journey",
        "proof": { "test": "a_reasons_details_cannot_be_a_non_value", "file": "crates/itinera/tests/proofs.rs" }
      },
      {
        "feature": "cases/tier-1/0011-events/emitted-by-steps-and-hooks.feature",
        "scenario": "Data that is not a value aborts the journey, and the event is not delivered",
        "proof": { "test": "a_step_event_cannot_carry_a_non_value", "file": "crates/itinera/tests/proofs.rs" }
      }
    ],
    "mode-not-accepted": [
      {
        "feature": "cases/tier-1/0012-local-executor/local-executor.feature",
        "scenario": "A synchronous-only executor refuses an asynchronous step before the journey starts",
        "proof": { "test": "a_synchronous_executor_cannot_run_an_asynchronous_step", "file": "crates/itinera/tests/proofs.rs" }
      }
    ],
    "late-handle": [
      {
        "feature": "cases/tier-1/0057-handles-valid-during-their-attempt/late-handles.feature",
        "scenario": "A step's contributor and reporter used after its attempt change nothing",
        "proof": { "test": "a_steps_handles_cannot_outlive_its_attempt", "file": "crates/itinera/tests/proofs.rs" }
      }
    ]
  }
}
